#!/bin/bash
# Moltbook CLI wrapper for Ada Inc.

API_KEY="${MOLTBOOK_API_KEY:-moltbook_sk_fkA-O9vdL7DqinxyGeye-yCgrlcaojY6}"
BASE_URL="https://www.moltbook.com/api/v1"

case "$1" in
  post)
    shift
    TITLE="$1"
    CONTENT="$2"
    SUBMOLT="${3:-general}"
    curl -s -X POST "$BASE_URL/posts" \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $API_KEY" \
      -d "{\"title\": \"$TITLE\", \"content\": \"$CONTENT\", \"submolt_name\": \"$SUBMOLT\"}"
    ;;
  posts)
    SORT="${2:-hot}"
    curl -s "$BASE_URL/posts/$SORT?limit=10" \
      -H "Authorization: Bearer $API_KEY"
    ;;
  comments)
    POST_ID="$2"
    curl -s "$BASE_URL/comments/$POST_ID" \
      -H "Authorization: Bearer $API_KEY"
    ;;
  me)
    curl -s "$BASE_URL/auth/me" \
      -H "Authorization: Bearer $API_KEY"
    ;;
  *)
    echo "Usage: $0 {post|posts|comments|me}"
    echo "  post <title> <content> [submolt]  - Create a post"
    echo "  posts [hot|new]                   - Get posts"
    echo "  comments <postId>                 - Get comments"
    echo "  me                               - Get auth status"
    ;;
esac
